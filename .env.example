# Copy to .env. Everything here is optional; defaults are shown.
# Optional dashboard token; set a secret value before binding beyond localhost.
DASH_TOKEN=
# --- scanner filters ---
MIN_LIQUIDITY_USD=25000
MIN_VOLUME_24H_USD=50000
MIN_TXNS_24H=100
MAX_TOKENS_PER_SCAN=25
MAX_LOOKUPS_PER_SCAN=60
SCAN_INTERVAL=60
DEXSCREENER_TIMEOUT_SECONDS=20
DEXSCREENER_MAX_RETRIES=4
MAX_MARKET_MB=2048
TRACK_MINUTES=105
# --- model / labels ---
HORIZON_MINUTES=15
TARGET_RETURN=0.10
MODEL_THRESHOLD=0.70
GAP_MINUTES=5
BACKTEST_FEE=0.005
BACKTEST_SLIPPAGE=0.02
BACKTEST_START_BALANCE=1000
BACKTEST_MAX_POSITIONS=3
BACKTEST_POSITION_FRACTION=0.05
# --- scoring ---
BUY_SCORE=80
WATCH_SCORE=60
# --- safety filter (SOLANA_RPC_URL must be https; a private RPC is much more reliable than the public one) ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
MAX_TOP1_PCT=20
MAX_TOP10_PCT=50
MIN_AGE_MINUTES=30
MAX_LIQ_DROP_15=0.20
SAFETY_MAX_PER_SCAN=5
# --- Jupiter quote verification (read-only) ---
JUPITER_API_KEY=
QUOTE_CHECK=1
QUOTE_SIZE_SOL=0.1
MAX_ROUND_TRIP_LOSS_PCT=8
# --- paper risk engine ---
PAPER_START_BALANCE=1000
POSITION_FRACTION=0.05
MAX_TRADE_USD=50
MAX_LOSS_PER_TRADE=0.01
MAX_POSITIONS=3
MAX_TOKEN_EXPOSURE=0.10
STOP_LOSS=0.15
TAKE_PROFIT=0.30
TRAIL_ACTIVATE=0.10
TRAILING_STOP=0.10
MAX_HOLD_MINUTES=30
MAX_DAILY_LOSS=0.05
PAPER_ENTRIES_ANALYTICAL=1
# Do NOT put BOT_PRIVATE_KEY in this file.
